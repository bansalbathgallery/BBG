<%- include ('../header') %>
<%- include ('../../../partials/sidebar') %>
    <section id="content">
        <div class="container">
            <div class="card">
                <div class="card-header">
                    <div class="pull-left"><h2>Sale List</h2></div>
                    <div class="pull-right"><a href="<%- adminpath %>custmer"><button class="btn btn-primary waves-effect">Back</button></a></div>
                </div>
                <table id="data-table-command" class="table table-striped table-vmiddle">
                    <thead>
                        <tr>
                            <th data-column-id="name">Site Name</th>
                            <th data-column-id="Status">Address</th>
                            <th data-column-id="Phone">Sale</th>
                            <th data-column-id="type">Type</th>
                            <th data-column-id="date">Sale Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% for(var t=0;t<data.length;t++) { %>
                            <tr>
                                <td><%-data[t].name %>  </td>
                                <td><%-data[t].address %>  </td>
                                <td><%- data[t].sale %> </td>

                                <% if(data[t].type=="Deposit") var classsale = "text-success" %>
                                <% if(data[t].type=="Withdraw") var classsale = "text-danger" %>
                                <td class=<%=classsale %>> <%-data[t].type %>  </td>
                                <td> <%- data[t].date %> </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </section>
</section>
<%- include ('../../../partials/commonJs') %>

  