<%- include ('../header') %>
<%- include ('../../../partials/sidebar') %>
<section id="content">
<div class="container">
<div class="card">
                        <div class="card-header">
                            <h2>Sale Management</h2>
                        </div>
                        
                        <div class="card-body card-padding">
                            <div role="tabpanel">
                                <ul class="tab-nav" role="tablist">
                                     <li class="active"><a href="#push" aria-controls="push" role="tab" data-toggle="tab">Add New Sale</a></li>
                                </ul>
                              
                                <div class="tab-content">
                                    
                                    <div role="tabpanel" class="tab-pane active" id="settings11">
                                      <form role="form" id="saleform" method="POST"  enctype="multipart/form-data">
                                       <input type="hidden" name="userId" id="userId" value="<%-data.id%>">
                                        <div class="form-group fg-float">
                                            <div class="fg-line">
                                                <input type="text"  maxlength="60" id="sitename" name="sitename" class="input-sm form-control fg-input">
                                                <label class="fg-label">Owner Name</label>
                                            </div>
                                        </div>
                                        <br>
                                        <div class="form-group fg-float">
                                            <div class="fg-line">
                                                <input type="text" id="address" name="address" class="input-sm form-control fg-input">
                                                <label class="fg-label">Owner Address</label>
                                            </div>
                                        </div>
                                        <br>
                                        <div class="form-group fg-float">
                                            <div class="fg-line">
                                                <input  type="text" id="sale" name="sale" class="input-sm form-control fg-input input-mask" data-mask="000000">
                                                <label class="fg-label">Sale (Rs.)</label>
                                            </div>
                                        </div>
                                        <br>
                                        <div class="form-group fg-line m-t-20">
                                          <button  type="button" onclick="window.history.back();" class="btn btn-link btn-sm waves-effect">
                                             Cancel
                                          </button>
                                          <button class="btn btn-primary btn-sm waves-effect">Save</button>
                                        </div> 
                                      </form>
                                    </div>
                                </div>
                            </div>
                            
                            <br/>
                            <br/>


    </section>
</section>
  <%- include ('../../../partials/scripts') %>
  <%- include ('../../../partials/commonJs') %>
<script type="text/javascript">
  $(function() {
    $('#contentTab').addClass('active');
    $('#contentTab a[href^="<%- adminpath %>content"]').addClass('active');
  });

  $('#saleform').validate({
    rules: {
        sitename: {
            required: true,
            minlength: 3
        }, 
          address: {
            required: true,
            minlength: 5
        },    
        sale: {
            required: true
        }
    },
    messages: {
          sitename: {
              required: "Please provide a sitename."
          },
          address: {
              required: "Please provide a site address",
              minlength: "address should be atleast six characters"
          },
          sale: {
              required: "Please provide a sale"
          }
    },
    submitHandler: function (form) {
      $(".page-loader").show();
      var tempform = $('#saleform');
      var form_data = new FormData(tempform[0]);
      $.ajax({
            type: 'POST',
             url: '<%-adminpath%>/customer/updateSale',
            dataType: 'json',
            data: form_data,
            contentType:false,
            cache:false,
            processData:false,
            success: function (response) {
            console.log(response);
            if (response.code == '200') {
              showToastSuccess( response.message);
              $(".page-loader").hide();
              setTimeout(function(){ window.location.reload(); },1000); 
            }
            else{
               $(".page-loader").hide();
                showToastError(response.message)
            }
          }
      });
    }
  });
  
</script>


 </body>
</html>